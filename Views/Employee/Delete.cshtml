@model EmployeeManagementSystem.Models.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<h1 class="h3">Delete Employee</h1>
<h5 class="text-danger">Are you sure you want to delete this employee?</h5>
<hr />

<div class="d-flex align-items-center mb-3">
    @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
    {
        <img src="@Model.ProfileImagePath"
             alt="@Model.FullName"
             width="80" height="80"
             class="rounded-circle me-3"
             style="object-fit:cover;" />
    }

    <div>
        <div class="fw-semibold fs-5">@Model.FullName</div>
        <div class="text-muted">#@Model.Id</div>
    </div>
</div>

<dl class="row">
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>

    <dt class="col-sm-2">Department</dt>
    <dd class="col-sm-10">@(Model.Department?.Name ?? "-")</dd>

    <dt class="col-sm-2">Job Title</dt>
    <dd class="col-sm-10">@(Model.JobTitle?.Title ?? "-")</dd>

    <dt class="col-sm-2">Hire Date</dt>
    <dd class="col-sm-10">@Model.HireDate.ToString("dd/MM/yyyy")</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>