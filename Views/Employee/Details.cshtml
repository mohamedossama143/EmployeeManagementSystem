@model EmployeeManagementSystem.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<h1 class="h3 mb-4">Employee Details</h1>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="row">

            <!-- Image -->
            <div class="col-md-3 text-center mb-3">
                @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
                {
                    <img src="@Model.ProfileImagePath"
                         alt="@Model.FullName"
                         class="img-thumbnail rounded-circle"
                         style="width:180px; height:180px; object-fit:cover;" />
                }
                else
                {
                    <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center"
                         style="width:180px; height:180px;">
                        <span class="display-3 fw-semibold text-muted">
                            @(string.IsNullOrEmpty(Model.FullName) ? "?" : Model.FullName.Substring(0, 1).ToUpper())
                        </span>
                    </div>
                }
            </div>

            <!-- Data -->
            <div class="col-md-9">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Full Name</dt>
                    <dd class="col-sm-9">@Model.FullName</dd>

                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9">@Model.Email</dd>

                    <dt class="col-sm-3">Phone</dt>
                    <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "-" : Model.PhoneNumber)</dd>

                    <dt class="col-sm-3">Department</dt>
                    <dd class="col-sm-9">@(Model.Department?.Name ?? "-")</dd>

                    <dt class="col-sm-3">Job Title</dt>
                    <dd class="col-sm-9">@(Model.JobTitle?.Title ?? "-")</dd>

                    <dt class="col-sm-3">Hire Date</dt>
                    <dd class="col-sm-9">@Model.HireDate.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-3">Salary</dt>
                    <dd class="col-sm-9">@Model.Salary.ToString("N2")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>