
@model IEnumerable<EmployeeManagementSystem.Models.Employee>

<div class="container-fluid px-4">

    <!-- Page Header -->
    <div class="mb-4">
        <h1 class="fw-bold mb-1">Employees</h1>
        <p class="text-muted mb-0">
            Manage and view all employees
        </p>
    </div>

    <!-- Employees Card -->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            <!-- Search & Filters -->
            <partial name="_SearchFilterForm" />

            @if (!Model.Any())
            {
                <!-- Empty State -->
                <div class="text-center py-5">

                    <h5 class="fw-semibold">
                        No employees found
                    </h5>

                    <p class="text-muted mb-0">
                        Try changing your search or filter criteria.
                    </p>

                </div>
            }
            else
            {
                <!-- Employee Table -->
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>Employee</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Department</th>
                                <th>Job Title</th>
                                <th>Hire Date</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var employee in Model)
                            {
                                <tr>

                                    <!-- Employee -->
                                    <td>

                                        <div class="d-flex align-items-center">

                                            @if (!string.IsNullOrEmpty(employee.ProfileImagePath))
                                            {
                                                <img src="@employee.ProfileImagePath"
                                                     alt="@employee.FullName"
                                                     width="45"
                                                     height="45"
                                                     class="rounded-circle me-3"
                                                     style="object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-3"
                                                     style="width:45px; height:45px;">

                                                    <span class="fw-semibold text-muted">
                                                        @(string.IsNullOrEmpty(employee.FullName)
                                                            ? "?"
                                                            : employee.FullName.Substring(0, 1).ToUpper())
                                                    </span>

                                                </div>
                                            }

                                            <div>

                                                <div class="fw-semibold">
                                                    @employee.FullName
                                                </div>

                                                <small class="text-muted">
                                                    #@employee.Id
                                                </small>

                                            </div>

                                        </div>

                                    </td>

                                    <!-- Email -->
                                    <td>
                                        @employee.Email
                                    </td>

                                    <!-- Phone -->
                                    <td>
                                        @(string.IsNullOrEmpty(employee.PhoneNumber)
                                            ? "-"
                                            : employee.PhoneNumber)
                                    </td>

                                    <!-- Department -->
                                    <td>

                                        @if (employee.Department != null)
                                        {
                                            <span class="badge bg-light text-dark">
                                                @employee.Department.Name
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }

                                    </td>

                                    <!-- Job Title -->
                                    <td>
                                        @(employee.JobTitle?.Title ?? "-")
                                    </td>

                                    <!-- Hire Date -->
                                    <td>
                                        @employee.HireDate.ToString("dd/MM/yyyy")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <!-- Pagination -->
                @if ((int)ViewBag.TotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-4">

                        <div class="text-muted">
                            Page
                            <strong>@ViewBag.CurrentPage</strong>
                            of
                            <strong>@ViewBag.TotalPages</strong>
                        </div>

                        <div class="d-flex gap-2">

                            @if ((int)ViewBag.CurrentPage > 1)
                            {
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-action="Index"
                                   asp-route-page="@((int)ViewBag.CurrentPage - 1)"
                                   asp-route-search="@ViewBag.Search"
                                   asp-route-departmentId="@ViewBag.DepartmentId"
                                   asp-route-jobTitleId="@ViewBag.JobTitleId">
                                    Previous
                                </a>
                            }

                            @if ((int)ViewBag.CurrentPage < (int)ViewBag.TotalPages)
                            {
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-action="Index"
                                   asp-route-page="@((int)ViewBag.CurrentPage + 1)"
                                   asp-route-search="@ViewBag.Search"
                                   asp-route-departmentId="@ViewBag.DepartmentId"
                                   asp-route-jobTitleId="@ViewBag.JobTitleId">
                                    Next
                                </a>
                            }

                        </div>

                    </div>
                }

            }

        </div>

    </div>

</div>



