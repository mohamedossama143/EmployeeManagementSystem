@model IEnumerable<EmployeeManagementSystem.Models.Employee>

<h1>Employees</h1>

<partial name="_SearchFilterForm" />

@if (!Model.Any())
{
    <p><strong>No employees found.</strong></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Department</th>
                <th>Job Title</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.FullName</td>
                    <td>@e.Email</td>
                    <td>@e.Department.Name</td>
                    <td>@e.JobTitle.Title</td>
                </tr>
            }
        </tbody>
    </table>

    @if ((int)ViewBag.TotalPages > 1)
    {
        <div class="mt-2 d-flex align-items-center gap-2">
            <a class="btn btn-sm btn-outline-primary @((int)ViewBag.CurrentPage <= 1 ? "disabled" : "")"
               asp-action="Index"
               asp-route-page="@((int)ViewBag.CurrentPage - 1)"
               asp-route-search="@ViewBag.Search"
               asp-route-departmentId="@ViewBag.DepartmentId"
               asp-route-jobTitleId="@ViewBag.JobTitleId">Previous</a>

            <span>Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>

            <a class="btn btn-sm btn-outline-primary @((int)ViewBag.CurrentPage >= (int)ViewBag.TotalPages ? "disabled" : "")"
               asp-action="Index"
               asp-route-page="@((int)ViewBag.CurrentPage + 1)"
               asp-route-search="@ViewBag.Search"
               asp-route-departmentId="@ViewBag.DepartmentId"
               asp-route-jobTitleId="@ViewBag.JobTitleId">Next</a>
        </div>
    }
}