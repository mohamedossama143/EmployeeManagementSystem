<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="search" value="@ViewBag.Search"
               class="form-control" placeholder="Search by name or email" />
    </div>
    <div class="col-md-3">
        <select name="departmentId" asp-items="(SelectList)ViewBag.Departments" class="form-select">
            <option value="">All Departments</option>
        </select>
    </div>
    <div class="col-md-3">
        <select name="jobTitleId" asp-items="(SelectList)ViewBag.JobTitles" class="form-select">
            <option value="">All Job Titles</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>