@model EmployeeManagementSystem.Models.JobTitle

@{
    ViewData["Title"] = "Delete Job Title";
}

<h1>Delete Job Title</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<h3>Are you sure you want to delete this job title?</h3>

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Title)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Title)</dd>

            <dt class="col-sm-4">Employees with this title</dt>
            <dd class="col-sm-8">@(Model.Employees?.Count ?? 0)</dd>
        </dl>

        @if (Model.Employees != null && Model.Employees.Any())
        {
            <div class="alert alert-warning">
                This job title is assigned to @Model.Employees.Count employee(s) and cannot be deleted until they are reassigned.
            </div>
        }

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger" @(Model.Employees != null && Model.Employees.Any() ? "disabled" : "")>Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
