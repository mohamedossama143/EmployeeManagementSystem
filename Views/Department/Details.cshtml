@model EmployeeManagementSystem.Models.Department

@{
    ViewData["Title"] = "Department Details";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Department Details</h1>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Department Information</h6>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Id)</dt>
            <dd class="col-sm-10">@Model.Id</dd>

            <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Name)</dt>
            <dd class="col-sm-10">@Model.Name</dd>
        </dl>

        <h6 class="font-weight-bold">Employees (@(Model.Employees?.Count ?? 0))</h6>
        @if (Model.Employees != null && Model.Employees.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle" width="100%" cellspacing="0">
                    <thead class="table-light">
                        <tr><th>Full Name</th><th>Email</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in Model.Employees)
                        {
                            <tr>
                                <td>@emp.FullName</td>
                                <td>@emp.Email</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">No employees in this department.</p>
        }

        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="fas fa-edit"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>
</div>