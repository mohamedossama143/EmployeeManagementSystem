@model EmployeeManagementSystem.Models.Department

@{
    ViewData["Title"] = "Delete Department";
    var employeesCount = Model.Employees?.Count ?? 0;
}

<h1 class="h3">Delete Department</h1>
<h5 class="text-danger">Are you sure you want to delete this department?</h5>
<hr />

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Name)</dt>
    <dd class="col-sm-10">@Model.Name</dd>
</dl>

@if (employeesCount > 0)
{
    <div class="alert alert-warning">
        This department has @employeesCount employee(s), so it can't be deleted.
        Move or delete them first.
    </div>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
}
else
{
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
}