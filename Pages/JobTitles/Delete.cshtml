@page "{id:int}"
@model EmployeeManagementSystem.Pages.JobTitles.DeleteModel

@{
    ViewData["Title"] = "Delete Job Title";
}

<h1>Delete Job Title</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<h3>Are you sure you want to delete this job title?</h3>

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Title</dt>
            <dd class="col-sm-8">@Model.JobTitle.Title</dd>

            <dt class="col-sm-4">Employees with this title</dt>
            <dd class="col-sm-8">@(Model.JobTitle.Employees?.Count ?? 0)</dd>
        </dl>

        @if (Model.JobTitle.Employees != null && Model.JobTitle.Employees.Any())
        {
            <div class="alert alert-warning">
                This job title is assigned to @Model.JobTitle.Employees.Count employee(s) and cannot be deleted until they are reassigned.
            </div>
        }

        <form method="post">
            <input type="hidden" asp-for="JobTitle.Id" />
            <button type="submit" class="btn btn-danger" @(Model.JobTitle.Employees != null && Model.JobTitle.Employees.Any() ? "disabled" : "")>Delete</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
