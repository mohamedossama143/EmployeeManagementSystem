@page "{id:int}"
@model EmployeeManagementSystem.Pages.JobTitles.DeleteModel

@{
    ViewData["Title"] = "Delete Job Title";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Delete Job Title</h1>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow mb-4 border-left-danger">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-danger">Are you sure you want to delete this job title?</h6>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.JobTitle.Title</dd>

            <dt class="col-sm-3">Employees with this title</dt>
            <dd class="col-sm-9">@(Model.JobTitle.Employees?.Count ?? 0)</dd>
        </dl>

        @if (Model.JobTitle.Employees != null && Model.JobTitle.Employees.Any())
        {
            <div class="alert alert-warning">
                This job title is assigned to @Model.JobTitle.Employees.Count employee(s) and cannot be deleted until they are reassigned.
            </div>
        }

        <form method="post">
            <input type="hidden" asp-for="JobTitle.Id" />
            <button type="submit" class="btn btn-danger" @(Model.JobTitle.Employees != null && Model.JobTitle.Employees.Any() ? "disabled" : "")>
                <i class="fas fa-trash"></i> Delete
            </button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>