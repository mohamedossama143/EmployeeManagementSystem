@page "{id:int}"
@model EmployeeManagementSystem.Pages.JobTitles.EditModel

@{
    ViewData["Title"] = "Edit Job Title";
}

<h1>Edit Job Title</h1>

<div class="row">
    <div class="col-md-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="JobTitle.Id" />
            <div class="mb-3">
                <label asp-for="JobTitle.Title" class="form-label"></label>
                <input asp-for="JobTitle.Title" class="form-control" autofocus />
                <span asp-validation-for="JobTitle.Title" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
