@page
@model EmployeeManagementSystem.Pages.JobTitles.IndexModel

@{
    ViewData["Title"] = "Job Titles";
}

<h1>Job Titles</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <form method="get" class="d-flex" role="search">
        <input type="text" name="Search" value="@Model.Search" class="form-control me-2" placeholder="Search job titles..." />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </form>
    <a asp-page="Create" class="btn btn-primary">+ New Job Title</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Title</th>
            <th># Employees</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
    @if (!Model.JobTitles.Any())
    {
        <tr>
            <td colspan="3" class="text-center text-muted py-4">No job titles found.</td>
        </tr>
    }
    else
    {
        @foreach (var item in Model.JobTitles)
        {
            <tr>
                <td>@item.Title</td>
                <td>@(item.Employees?.Count ?? 0)</td>
                <td class="text-end">
                    <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                    <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    }
    </tbody>
</table>
