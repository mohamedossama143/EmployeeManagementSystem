@page "{id:int}"
@model EmployeeManagementSystem.Pages.JobTitles.DetailsModel

@{
    ViewData["Title"] = "Job Title Details";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Job Title Details</h1>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Job Title Information</h6>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.JobTitle.Title</dd>

            <dt class="col-sm-3">Employees with this title</dt>
            <dd class="col-sm-9">@(Model.JobTitle.Employees?.Count ?? 0)</dd>
        </dl>

        @if (Model.JobTitle.Employees != null && Model.JobTitle.Employees.Any())
        {
            <h6 class="font-weight-bold">Assigned Employees</h6>
            <ul class="list-group mb-3">
                @foreach (var emp in Model.JobTitle.Employees)
                {
                    <li class="list-group-item">@emp.FullName</li>
                }
            </ul>
        }

        <a asp-page="Edit" asp-route-id="@Model.JobTitle.Id" class="btn btn-warning">
            <i class="fas fa-edit"></i> Edit
        </a>
        <a asp-page="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>
</div>